[Unit]
Description=hyptcn benign lab maintenance (VACUUM ANALYZE, compression of the document log)
After=postgresql.service

[Service]
Type=oneshot
User=hyptcnlab
Group=hyptcnlab
WorkingDirectory=/opt/hyptcn-lab
ExecStart=/usr/bin/python3 -u /opt/hyptcn-lab/services.py udrzba
# 75 (EX_TEMPFAIL): the database was unreachable or a table stayed locked; the run is skipped and its line
# in the journal says why (lab/services.py udrzba).
SuccessExitStatus=75
# Executor's judgment (B5a): VACUUM waits at most 10 s for a lock and runs at most 120 s.
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hyptcn-lab
