[Unit]
Description=hyptcn benign lab %i
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=hyptcnlab
Group=hyptcnlab
EnvironmentFile=/etc/hyptcn-lab.env
WorkingDirectory=/opt/hyptcn-lab
ExecStart=/usr/bin/python3 -u /opt/hyptcn-lab/services.py %i
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
