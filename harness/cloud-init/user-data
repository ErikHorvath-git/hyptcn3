#cloud-config
# Seed pre golden image (B1). Prevzate z fungujuceho seedu domény
# hyptcn-guest (cloud-init.iso), z neho odstránené heslá - prístup je
# len cez SSH kľúč nižšie (verejný kľúč hostiteľa).
users:
  - name: debian
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGyV9uwYAl+ef/zobGdVislKzyhjYjY0Q0IsgJArrpDa hyptcn-host
  - name: root
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGyV9uwYAl+ef/zobGdVislKzyhjYjY0Q0IsgJArrpDa hyptcn-host

ssh_pwauth: false

package_update: false
package_upgrade: false

network:
  version: 2
  ethernets:
    all-en:
      match:
        name: "en*"
      dhcp4: true
    all-eth:
      match:
        name: "eth*"
      dhcp4: true

runcmd:
  - echo "cloud-init done" > /tmp/cloud-init-complete
  # qemu-guest-agent: sedenia ním injikujú binárku a odoberajú pozemnú
  # pravdu aj bez siete (B4). Genericcloud obraz ho štandardne nemá.
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y qemu-guest-agent
  - systemctl enable --now qemu-guest-agent || true
  # Zataze C (blok C): nginx+wrk, pgbench, build, rsync+tar|zstd. Merane
  # 2026-10-05: instalacia tychto balikov do hotovej VM cez NAT trvala
  # ~50 min bez dokoncenia - preto patria do GOLDEN obrazu, nie do
  # apt_packages sedenia (apt_packages ostava pre drobne doplnky).
  - DEBIAN_FRONTEND=noninteractive apt-get install -y nginx wrk postgresql gcc zstd rsync || true

