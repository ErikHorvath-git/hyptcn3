    "read_heavy": {
      "workers": 6,
      "burst": 0.5,
      "catalog_share": 0.85,
      "write_share": 0.02
    },
    "write_heavy": {
      "workers": 6,
      "burst": 0.5,
      "catalog_share": 0.15,
      "write_share": 0.65
    },
    "mixed": {
      "workers": 5,
      "burst": 0.7,
      "catalog_share": 0.35,
      "write_share": 0.35
