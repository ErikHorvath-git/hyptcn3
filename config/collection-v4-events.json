    "duration_s": [
      120,
      360
    ],
    "first_s": 600,
    "min_gap_s": 600,
    "tail_s": 600,
    "grace_s": 60,
    "pilot": [
      {
        "type": "zla_konfiguracia_nginx",
        "start_s": 600,
        "duration_s": 180
