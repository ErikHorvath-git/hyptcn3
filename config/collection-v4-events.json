{
  "schema": "hyptcn3/collection-protocol/2",
  "name": "server-events-v4",
  "vms": [
    {
      "name": "a",
      "domain": "hyptcn-lab",
      "port": 18080
    },
    {
      "name": "b",
      "domain": "hyptcn-lab-b",
      "port": 18081
